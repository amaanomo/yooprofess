{
  "manifest_version": 3,
  "name": "Nova: Lecture Tutor",
  "version": "0.2.0",
  "description": "An AI tutor that follows along with your Panopto lecture. Say \"Hey Nova\" to ask out loud.",
  "permissions": ["storage", "tabs", "offscreen", "scripting", "alarms", "tts"],
  "host_permissions": ["https://*.panopto.com/*", "http://localhost:8000/*", "https://*.railway.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Show or hide Nova",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.panopto.com/Panopto/Pages/Viewer.aspx*",
        "https://*.panopto.com/Panopto/Pages/Embed.aspx*"
      ],
      "js": ["srt.js", "commands.js", "translator.js", "voice.js", "subtitles.js", "notes.js",
  "overlay.js", "spotter.js", "voice-client.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "subtitles.css", "icons/nova.png"],
      "matches": ["https://*.panopto.com/*"]
    }
  ]
}
