{
  "manifest_version": 3,
  "name": "Orbit: Lecture Tutor",
  "version": "0.1.0",
  "description": "An AI tutor that follows along with your Panopto lecture. Ask about what was just said.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.panopto.com/*", "http://localhost:8000/*", "https://*.railway.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show or hide Orbit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.panopto.com/Panopto/Pages/Viewer.aspx*",
        "https://*.panopto.com/Panopto/Pages/Embed.aspx*"
      ],
      "js": ["srt.js", "overlay.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "icons/orbit.png"],
      "matches": ["https://*.panopto.com/*"]
    }
  ]
}
